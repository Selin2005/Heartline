<?xml version="1.0" encoding="utf-8"?>
<!-- Colour badge for the "Start ECG" watch-face shortcut: the ECG icon on the app's ECG red. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFF5A6E" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:drawable="@drawable/ic_metric_ecg"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
